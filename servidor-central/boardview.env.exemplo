# /etc/boardview.env — lido pelo boardview.service. Depois de mudar:
#   sudo systemctl restart boardview
#
# Nome do servidor na tailnet, SEM porta (o "tailscale serve" usa HTTPS na 443).
# E o nome que aparece em "tailscale status" + o dominio da tailnet. Sem ele o
# navegador recebe 421 "host nao reconhecido".
BOARDVIEW_HOSTS=maquina.tailnet-exemplo.ts.net

# Pasta com os dados das placas (PDFs, .pcb) servida em /_drones/. Opcional: sem ela
# o viewer e o caderno funcionam; so os links do HUB para PDFs/.pcb dao 404.
BOARDVIEW_DRONES=/opt/boardview-drones
